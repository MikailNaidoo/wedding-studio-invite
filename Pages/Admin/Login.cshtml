@page
@model WeddingStudioInvite.Pages.Admin.LoginModel
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Login | Mikail & Dershia</title>
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/vendor/mazer/assets/css/bootstrap.css" />
    <link rel="stylesheet" href="/vendor/mazer/assets/vendors/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="/vendor/mazer/assets/css/app.css" />
    <link rel="stylesheet" href="/vendor/mazer/assets/css/pages/auth.css" />
    <link rel="stylesheet" href="/css/admin.css" />
  </head>
  <body class="admin-body mazer-login">
    <div id="auth">
      <div class="row h-100">
        <div class="col-lg-5 col-12">
          <main id="auth-left">
            <a class="mazer-brand auth-brand" href="/">M&D</a>
            <p class="admin-kicker">Mikail & Dershia</p>
            <h1 class="auth-title">Admin login.</h1>
            <p class="auth-subtitle mb-5">View and manage wedding RSVP responses for 29 August 2027.</p>

            <form method="post" class="admin-form">
              <div class="form-group position-relative has-icon-left mb-4">
                <input class="form-control form-control-xl" asp-for="Username" autocomplete="username" placeholder="Username" required />
                <div class="form-control-icon">
                  <i class="bi bi-person"></i>
                </div>
              </div>
              <div class="form-group position-relative has-icon-left mb-4">
                <input class="form-control form-control-xl" asp-for="Password" type="password" autocomplete="current-password" placeholder="Password" required />
                <div class="form-control-icon">
                  <i class="bi bi-shield-lock"></i>
                </div>
              </div>
              @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
              {
                <p class="alert alert-danger admin-error">@Model.ErrorMessage</p>
              }
              <button class="btn btn-primary btn-block btn-lg shadow-lg mt-4" type="submit">
                <i class="bi bi-box-arrow-in-right"></i> Log in
              </button>
            </form>

            <div class="text-center mt-5 text-lg fs-5">
              <p class="text-gray-600"><a class="font-bold" href="/">Back to invitation</a></p>
              <p class="text-muted small">Admin theme powered by local Mazer assets.</p>
            </div>
          </main>
        </div>
        <div class="col-lg-7 d-none d-lg-block">
          <aside id="auth-right" aria-label="Wedding admin artwork">
            <div class="auth-art-panel">
              <span class="admin-kicker">The Bell Inn</span>
              <h2>South Indian wedding RSVP control room</h2>
              <p>Confirmation, dietary notes, guest counts, and admin status updates in one calm dashboard.</p>
            </div>
          </aside>
        </div>
      </div>
    </div>
    <script src="/vendor/mazer/assets/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
