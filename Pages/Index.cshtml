@page
@model WeddingStudioInvite.Pages.IndexModel
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mikail Naidoo & Dershia Nadesan | Wedding Invitation</title>
    <meta name="description" content="A romantic South Indian wedding invitation for Mikail Naidoo and Dershia Nadesan." />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top">M&D</a>
      <nav aria-label="Wedding navigation">
        <a href="#invitation">Invitation</a>
        <a href="#couple">Couple</a>
        <a href="#day">Day</a>
        <a href="#place">Place</a>
        <a href="#rsvp">RSVP</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title" data-scroll-scene>
        <div class="hero-slideshow" aria-hidden="true" data-scroll-layer data-scroll-speed="-42" data-scroll-scale="0.03">
          <figure class="hero-slide hero-slide-couple is-active" data-hero-slide data-slide-label="Blessed beginning">
            <img src="/assets/wedding-hero.png" alt="" />
          </figure>
          <figure class="hero-slide" data-hero-slide data-slide-label="Mandap vows" aria-hidden="true">
            <img src="/assets/wedding-mandap.png" alt="" />
          </figure>
          <figure class="hero-slide" data-hero-slide data-slide-label="Family celebration" aria-hidden="true">
            <img src="/assets/gallery-celebration.png" alt="" />
          </figure>
        </div>
        <div class="hero-overlay">
          <p class="eyebrow reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="55">Wedding invitation</p>
          <h1 id="hero-title" data-scroll-layer data-scroll-speed="52">
            <span data-scroll-layer data-scroll-speed="-12">Save</span>
            <strong data-scroll-layer data-scroll-speed="18">the</strong>
            <em data-scroll-layer data-scroll-speed="28">date</em>
          </h1>
          <p class="hero-names reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="78">
            Mikail Naidoo & Dershia Nadesan
          </p>
          <p class="hero-copy reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="48">
            We are honoured to invite you to celebrate our new beginning with ceremony, family, blessings, and joy.
          </p>
        </div>
        <a class="special-card" href="#gallery" aria-label="View wedding gallery" data-scroll-layer data-scroll-speed="-36" data-reveal>
          <figure class="photo-placeholder photo-frame special-card-photo" aria-hidden="true">
            <img src="/assets/wedding-card-detail.png" alt="" />
          </figure>
          <span>Special Thanks</span>
          <strong id="special-card-label">Blessed beginning</strong>
          <i class="special-arrow" aria-hidden="true">-&gt;</i>
        </a>
      </section>

      <section id="invitation" class="section invitation-section lime-editorial-section" aria-labelledby="invitation-title" data-scroll-scene>
        <span class="editorial-watermark" aria-hidden="true">M&D</span>
        <span class="kolam-line kolam-line-one" aria-hidden="true"></span>
        <span class="kolam-line kolam-line-two" aria-hidden="true"></span>
        <div class="section-inner invitation-grid">
          <p class="vertical-title" data-scroll-layer data-scroll-speed="-90">Invitation</p>
          <div>
            <p class="eyebrow reveal-stagger" data-reveal>With love and gratitude</p>
            <h2 id="invitation-title" class="reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="42">
              Together with their families, Mikail Naidoo and Dershia Nadesan request the pleasure of your company.
            </h2>
            <p class="reveal-stagger" data-reveal>
              Join us for a South Indian wedding celebration at The Bell Inn, where sacred rituals, a generous feast,
              and joyful dancing will mark the beginning of our married life.
            </p>
          </div>
        </div>
      </section>

      <section id="couple" class="section couple-section" aria-labelledby="couple-title" data-scroll-scene>
        <div class="section-inner">
          <p class="eyebrow reveal-stagger" data-reveal>Bride & groom</p>
          <h2 id="couple-title" class="reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="52">Two stories, one day.</h2>
          <div class="profile-grid">
            <article class="profile-card reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="-38">
              <figure class="photo-placeholder photo-frame profile-photo" data-scroll-layer data-scroll-speed="-62">
                <img src="/assets/mikail-portrait.png" alt="South Indian wedding artwork portrait of Mikail Naidoo in a grey double-breasted suit with a tie, mustache, and goatee" />
                <figcaption>Mikail Naidoo</figcaption>
              </figure>
              <p class="profile-number">01</p>
              <h3>Mikail Naidoo</h3>
              <p>Mikail steps into the day with warmth, gratitude, and the joy of welcoming every loved one into the celebration.</p>
            </article>
            <article class="profile-card reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="46">
              <figure class="photo-placeholder photo-frame profile-photo profile-photo-bride" data-scroll-layer data-scroll-speed="-78">
                <img src="/assets/dershia-portrait.png" alt="South Indian wedding artwork portrait of Dershia Nadesan in cream and gold bridal attire" />
                <figcaption>Dershia Nadesan</figcaption>
              </figure>
              <p class="profile-number">02</p>
              <h3>Dershia Nadesan</h3>
              <p>Dershia brings grace, laughter, and a luminous heart to a celebration surrounded by family, blessings, and love.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="day" class="section day-section" aria-labelledby="day-title" data-scroll-scene>
        <div class="section-inner day-layout">
          <div data-scroll-layer data-scroll-speed="58">
            <p class="eyebrow">Day</p>
            <h2 id="day-title">Sunday, 29 August 2027</h2>
            <p>Please arrive from 10:00 so everyone can be seated before the ceremony begins.</p>
            <figure class="photo-placeholder photo-frame ceremony-photo reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="-74">
              <img src="/assets/wedding-mandap.png" alt="Ornate South Indian wedding mandap with brass lamps and flower garlands" />
              <figcaption>The ceremony mandap</figcaption>
            </figure>
          </div>
          <div class="schedule-list" aria-label="Wedding schedule">
            <article class="reveal-stagger" data-reveal><span>10:00</span><strong>Guest arrival</strong><p>Greetings, seating, and time with family.</p></article>
            <article class="reveal-stagger" data-reveal><span>11:00</span><strong>Wedding ceremony</strong><p>Traditional vows and blessings.</p></article>
            <article class="reveal-stagger" data-reveal><span>13:00</span><strong>Feast</strong><p>South Indian-inspired lunch and speeches.</p></article>
            <article class="reveal-stagger" data-reveal><span>16:00</span><strong>Celebration</strong><p>Music, dessert, and dancing.</p></article>
          </div>
        </div>
      </section>

      <section id="place" class="section place-section dark-place-section" aria-labelledby="place-title" data-scroll-scene>
        <span class="editorial-watermark place-watermark" aria-hidden="true">Place</span>
        <div class="section-inner place-grid">
          <div data-reveal class="reveal-stagger">
            <p class="eyebrow">Place</p>
            <h2 id="place-title">The Bell Inn</h2>
            <p>208 Kenneth Kaunda Road, Durban North, 4051</p>
            <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=The%20Bell%20Inn%20208%20Kenneth%20Kaunda%20Road%20Durban%20North%204051" target="_blank" rel="noreferrer">
              Open directions <span class="venue-link-icon" aria-hidden="true">-&gt;</span>
            </a>
          </div>
          <div class="map-panel reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="-54">
            <iframe title="Google Map showing The Bell Inn" src="https://www.google.com/maps?q=The%20Bell%20Inn%2C%20208%20Kenneth%20Kaunda%20Road%2C%20Durban%20North%2C%204051&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          </div>
        </div>
      </section>

      <section id="rsvp" class="section rsvp-section" aria-labelledby="rsvp-title" data-scroll-scene>
        <div class="section-inner rsvp-layout">
          <div class="reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="48">
            <p class="eyebrow">RSVP</p>
            <h2 id="rsvp-title">Please reply by 15 December 2026.</h2>
            <p>Your response will be saved securely so we can plan the ceremony, seating, and feast with care.</p>
          </div>
          <form id="rsvp-form" class="rsvp-form reveal-stagger" method="post" asp-page-handler="Rsvp" data-reveal data-scroll-layer data-scroll-speed="-42">
            <div asp-validation-summary="ModelOnly" class="form-status"></div>
            <input type="hidden" name="Input.StartedAtTicks" value="@Model.StartedAtTicks" />
            <div class="form-trap" aria-hidden="true">
              <label for="Input_Website">Website</label>
              <input id="Input_Website" name="Input.Website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <label>
              Full name
              <input name="Input.FullName" type="text" autocomplete="name" value="@Model.Input.FullName" required />
            </label>
            <fieldset>
              <legend>Will you attend?</legend>
              <label class="choice">
                @if (Model.Input.Attending == true)
                {
                  <input name="Input.Attending" type="radio" value="true" required checked />
                }
                else
                {
                  <input name="Input.Attending" type="radio" value="true" required />
                }
                Yes, joyfully
              </label>
              <label class="choice">
                @if (Model.Input.Attending == false)
                {
                  <input name="Input.Attending" type="radio" value="false" checked />
                }
                else
                {
                  <input name="Input.Attending" type="radio" value="false" />
                }
                Sadly, no
              </label>
            </fieldset>
            <label>
              Guests attending
              <input name="Input.GuestCount" type="number" min="0" max="12" value="@Model.Input.GuestCount" />
            </label>
            <label>
              Dietary notes
              <textarea name="Input.DietaryNotes" rows="4">@(Model.Input.DietaryNotes ?? "")</textarea>
            </label>
            <label>
              Message for the couple
              <textarea name="Input.GuestMessage" rows="4">@(Model.Input.GuestMessage ?? "")</textarea>
            </label>
            <button type="submit">Send RSVP</button>
            <p id="form-status" class="form-status" role="status" aria-live="polite">@Model.FormStatus</p>
          </form>
        </div>
      </section>

      <section id="gallery" class="section gallery-section" aria-labelledby="gallery-title" data-scroll-scene>
        <div class="section-inner">
          <p class="eyebrow reveal-stagger" data-reveal>Special Thanks</p>
          <h2 id="gallery-title" class="reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="44">A gallery of the moments we are dreaming toward.</h2>
          <div class="gallery-grid">
            <figure class="photo-placeholder photo-frame gallery-photo reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="-92">
              <img src="/assets/gallery-couple.png" alt="South Indian wedding artwork of Mikail and Dershia seated together, with Mikail in a grey double-breasted suit with a tie, mustache, and goatee, and Dershia in cream and gold bridal attire" />
              <figcaption>Our moment</figcaption>
            </figure>
            <figure class="photo-placeholder photo-frame gallery-photo reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="74">
              <img src="/assets/gallery-details.png" alt="South Indian wedding ritual details with brass lamp, flowers, coconut, and jewellery" />
              <figcaption>Ritual details</figcaption>
            </figure>
            <figure class="photo-placeholder photo-frame gallery-photo reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="-44">
              <img src="/assets/gallery-celebration.png" alt="South Indian wedding celebration setting with flowers, lamps, and sweets" />
              <figcaption>Celebration glow</figcaption>
            </figure>
          </div>
          <p class="closing-note reveal-stagger" data-reveal data-scroll-layer data-scroll-speed="38">
            Thank you for being part of the love, laughter, and blessings around us.
          </p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>© 2027 Mikail Naidoo & Dershia Nadesan</p>
      <a href="/admin">Admin dashboard</a>
      <a href="#top">Back to top</a>
    </footer>

    <script type="module" src="/app.js"></script>
  </body>
</html>
